[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/notifications/luma_notification.gd" id="1_notification"]

[node name="Notification" type="PanelContainer"]
custom_minimum_size = Vector2(320, 96)
theme_type_variation = &"Notification"
script = ExtResource("1_notification")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Marker" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(36, 0)
theme_type_variation = &"SelectedMarker"
text = "i"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Text" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PanelHeading"
text = "Notification"

[node name="Message" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Reusable message surface."
autowrap_mode = 3
