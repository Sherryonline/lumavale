[gd_scene format=3]

[node name="TooltipPanel" type="PanelContainer"]
custom_minimum_size = Vector2(280, 0)
theme_type_variation = &"TooltipPanel"
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"DarkPanelHeading"
text = "Forest Sword"

[node name="Type" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"DarkLabel"
text = "Type: Weapon"
autowrap_mode = 2

[node name="Rarity" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"GoldDarkLabel"
text = "Rarity: Rare"
autowrap_mode = 2

[node name="Description" type="RichTextLabel" parent="Content"]
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
theme_type_variation = &"DarkRichText"
bbcode_enabled = true
text = "A balanced blade issued to new LumaVale adventurers."
fit_content = true
scroll_active = false

[node name="Stats" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"DarkLabel"
text = "Stats: Attack +12"
autowrap_mode = 2

[node name="Requirements" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"DarkLabel"
text = "Requirements: Level 1"
autowrap_mode = 2

[node name="Value" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"GoldDarkLabel"
text = "Value: 45 gold"
autowrap_mode = 2
